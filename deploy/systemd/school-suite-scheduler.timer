# ==============================================================================
# Systemd Timer Unit — School Suite Scheduler
# Path: /etc/systemd/system/school-suite-scheduler.timer
# Commands:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now school-suite-scheduler.timer
# ==============================================================================

[Unit]
Description=Run School Suite Laravel Scheduler Every Minute

[Timer]
OnCalendar=*-*-* *:*:00
Persistent=true
Unit=school-suite-scheduler.service

[Install]
WantedBy=timers.target
