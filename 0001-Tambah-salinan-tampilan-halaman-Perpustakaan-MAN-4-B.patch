+        pdfDoc.getPage(num).then(function(page) {
+            var viewport = page.getViewport({ scale: pdfScale, rotation: pdfRotation });
+            var canvas = document.getElementById('pdf-page-canvas-' + num);
+            if (!canvas) {
+                delete pdfRenderingPages[num];
